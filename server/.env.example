# Lokonomy Server Environment Variables Template
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/lokonomy

# Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=your_jwt_access_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_chars
JWT_ADMIN_SECRET=your_jwt_admin_secret_key_at_least_32_chars

# Email Service (Nodemailer Gmail SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Resend Email Service (Optional fallback)
RESEND_API_KEY=your_resend_api_key

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payments (Use test keys for development)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Admin Seed Credentials
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=Password@123
